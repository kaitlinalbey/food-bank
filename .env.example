# Optional settings for the Food Bank Management System.
# None of these are required to run the classroom demo. The application does not
# read this file automatically; set the variables in your shell (or in compose.yaml).
# Never commit a real .env file. It is listed in .gitignore.

# Path of the central SQLite database (default: data/food_bank.db)
FOOD_BANK_DB_PATH=

# Folder for the per-node offline queue files (default: data/)
FOOD_BANK_QUEUE_DIR=

# 1 = classroom demo mode: creates the public demo accounts and enables the
# admin-only outage simulation. The launchers and compose.yaml set this to 1.
FOOD_BANK_DEMO_MODE=

# Secret used to sign node session cookies. If empty, a random value is generated
# at startup, so restarting a node logs everyone out. Use a long random string.
FOOD_BANK_SESSION_SECRET=

# 1 = mark session cookies Secure (only useful behind HTTPS)
FOOD_BANK_SECURE_COOKIES=

# How the central API reaches each node's /node-health address
# (default: http://127.0.0.1:{port}). compose.yaml sets http://bank{bank_id}:{port}.
FOOD_BANK_NODE_URL_TEMPLATE=

# 1 = load the expanded fictional sample data into a new database (used by Docker)
FOOD_BANK_SEED_EXPANDED=
